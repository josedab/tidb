id	name	age
1	alice	20
select * from t where id = 1;
id	name	age
1	alice	20
select * from t where id = 1;
id	name	age
1	alice	20
select * from t where age > 20;
id	name	age
2	bob	25
3	charlie	30
select * from t where age > 20;
id	name	age
2	bob	25
3	charlie	30
select * from t where age > 20;
id	name	age
2	bob	25
3	charlie	30
select count(*) from t;
count(*)
3
select count(*) from t;
count(*)
3
select count(*) from t;
count(*)
3
select count(*) from t;
count(*)
3
select digest_text, schema_name, exec_count
from information_schema.statements_summary
where digest_text like '%from t%' and exec_count >= 3
order by exec_count desc, digest_text;
digest_text	schema_name	exec_count
select * from `t` where `id` = ?	warmup	5
select count ( * ) from `t`	warmup	4
select * from `t` where `age` > ?	warmup	3
select digest_text into @query_text
from information_schema.statements_summary
where digest_text like 'select%from%t%' and exec_count >= 3
limit 1;
drop table if exists t;
